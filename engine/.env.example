# paperflow engine config — copy this file to `.env` and fill in your own key.
#   cp .env.example .env
# .env is gitignored (never commit your real key).

# ── 필수: OpenAI 키 하나면 데모가 돌아갑니다 ──────────────────────────
OPENAI_API_KEY=sk-여기에_본인_OpenAI_키

# ── 모델 (gpt-4o-mini = 어떤 OpenAI 계정에서도 동작, 저렴) ──────────────
PAPERFLOW_FAST_MODEL=openai:gpt-4o-mini
PAPERFLOW_WRITER_MODEL=openai:gpt-4o-mini
PAPERFLOW_REASONING_MODEL=openai:gpt-4o-mini
PAPERFLOW_CHAT_MODEL=openai:gpt-4o-mini

# 속도용: 섹션별 논리 재작성 검증 끄기 (off 권장, 데모 빠름)
PAPERFLOW_VALIDATE=off

# ── (선택) gpt-5-mini 접근이 되면 품질이 올라갑니다 ───────────────────
#   위 FAST/WRITER/REASONING 3줄을 openai:gpt-5-mini 로 바꾸세요.
# ── (선택) 다른 provider도 쓰려면 ────────────────────────────────────
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# ── (선택) figure 이미지 생성 (fal.ai) ───────────────────────────────
# FAL_KEY=
# PAPERFLOW_IMAGE_MODEL=fal:fal-ai/nano-banana-pro

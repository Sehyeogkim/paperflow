    {
      "id": "M1",
      "kind": "method",
      "text": "Cost‑effective pulsatile two‑way FSI pipeline used to generate simulation outputs for LAP (3 domains) and CP (4 domains). Follows prior validated cost‑efficient FSI setup (BCs, inflow, elastance) referenced in bc.md.",
      "parent_id": null,
      "subtype": "simulation",
      "role": "",
      "represented_as": null,
      "section": "method",
      "provenance": null
    },
    {
      "id": "M1.1",
      "kind": "method",
      "text": "FSI setup and preprocessing: map input design parameters (geometry, material, hemodynamic) from input.csv to model geometries (LAP: lumen/FC/lipid; CP: +calcification), assign linear isotropic elastic properties, prescribe inflow/elastance/BC from files.",
      "parent_id": "M1",
      "subtype": "preprocessing",
      "role": "",
      "represented_as": null,
      "section": "method",
      "provenance": null
    },
    {
      "id": "M1.2",
      "kind": "method",
      "text": "Transient cost‑effective pulsatile FSI runs for each design sample (time‑accurate Navier–Stokes for incompressible Newtonian blood + linear isotropic solid mechanics for vessel/plaque; two‑way coupling at interface).",
      "parent_id": "M1",
      "subtype": "simulation",
      "role": "",
      "represented_as": null,
      "section": "method",
      "provenance": null
    },
    {
      "id": "M1.3",
      "kind": "method",
      "text": "Postprocessing of FSI results: compute PSS fields, spherical‑mean ΔPSS (maximum amplitude over the cardiac cycle), FFR surrogate, and rupture‑location index.",
      "parent_id": "M1",
      "subtype": "analysis",
      "role": "",
      "represented_as": null,
      "section": "method",
      "provenance": null
    },
    {
      "id": "M2",
      "kind": "method",
      "text": "VI candidate generation and clinical sign concordance evaluation: compute 6 candidate VIs (2 stress definitions × 3 strength scenarios) and evaluate sign agreement with 7 established clinical high‑risk plaque features to select final VIs.",
      "parent_id": null,
      "subtype": "analysis",
      "role": "",
      "represented_as": null,
      "section": "method",
      "provenance": null
    },
    {
      "id": "M3",
      "kind": "method",
      "text": "Gaussian process regression (GPR) surrogate training: fit GPR surrogates for final VIs using valid simulation pairs (LAP and CP datasets) to enable large‑scale surrogate evaluations.",
      "parent_id": null,
      "subtype": "analysis",
      "role": "",
      "represented_as": null,
      "section": "method",
      "provenance": null
    },
    {
      "id": "id:M3.1",
